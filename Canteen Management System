        String keyword = foodSearchField.getText().trim();

        if (keyword.isEmpty()) {
            loadFoodItems();
            return;
        }

        foodModel.setRowCount(0);
        foodList.clear();
        foodMap.clear();

        String sql = "SELECT food_id,food_name,category,price,stock FROM food_items " +
                     "WHERE food_name LIKE ? OR category LIKE ? ORDER BY food_id";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, "%" + keyword + "%");
            ps.setString(2, "%" + keyword + "%");

            ResultSet rs = ps.executeQuery();
            fillFoodResults(rs);

        } catch (SQLException e) {
            showError("Search failed:\n" + e.getMessage());
        }
    }

    private void loadFoodItems() {
        if (foodModel == null) return;

        foodModel.setRowCount(0);
        foodList.clear();
        foodMap.clear();

        String sql = "SELECT food_id,food_name,category,price,stock FROM food_items ORDER BY food_id";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            fillFoodResults(rs);

        } catch (SQLException e) {
            showError("Could not load food menu:\n" + e.getMessage());
        }

        refreshFoodCombo();
    }

    private void fillFoodResults(ResultSet rs) throws SQLException {
        while (rs.next()) {
            FoodItem f = new FoodItem(
                    rs.getInt("food_id"),
                    rs.getString("food_name"),
                    rs.getString("category"),
                    rs.getDouble("price"),
                    rs.getInt("stock")
            );

            foodList.add(f);
            foodMap.put(f.getId(), f);

            foodModel.addRow(new Object[]{
                    f.getId(),
                    f.getName(),
                    f.getCategory(),
                    String.format(Locale.US, "%.2f", f.getPrice()),
                    f.getStock(),
                    f.getStock() > 0 ? "AVAILABLE" : "OUT OF STOCK"
            });
        }
    }

