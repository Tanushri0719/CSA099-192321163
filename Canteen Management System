    private void refreshFoodCombo() {
        if (orderFoodCombo == null) return;

        orderFoodCombo.removeAllItems();

        for (FoodItem f : foodList) {
            if (f.getStock() > 0) {
                orderFoodCombo.addItem(
                        f.getId() + " - " + f.getName() + " | Rs." +
                        String.format(Locale.US, "%.2f", f.getPrice()) +
                        " | Stock: " + f.getStock()
                );
            }
        }
    }

    private void searchOrderFood() {
        String keyword = orderSearchField.getText().trim().toLowerCase();

        orderFoodCombo.removeAllItems();

        for (FoodItem f : foodList) {
            if (f.getStock() > 0 &&
                (f.getName().toLowerCase().contains(keyword) ||
                 f.getCategory().toLowerCase().contains(keyword))) {

                orderFoodCombo.addItem(
                        f.getId() + " - " + f.getName() + " | Rs." +
                        String.format(Locale.US, "%.2f", f.getPrice()) +
                        " | Stock: " + f.getStock()
                );
            }
        }
    }

    private int selectedFoodId() {
        Object selected = orderFoodCombo.getSelectedItem();
        if (selected == null) return -1;

        String s = selected.toString();
        return Integer.parseInt(s.substring(0, s.indexOf(" - ")).trim());
    }

    private void addToCart() {
        try {
            int foodId = selectedFoodId();
            if (foodId < 0) throw new InvalidOrderException("Select a food item.");

            int qty = (Integer) quantitySpinner.getValue();
            FoodItem f = foodMap.get(foodId);

            if (f == null) throw new InvalidOrderException("Food item not found.");
            if (qty <= 0) throw new InvalidOrderException("Quantity must be greater than zero.");

            OrderItem existing = null;
            for (OrderItem item : cart) {
                if (item.getFoodId() == foodId) {
                    existing = item;
                    break;
                }
            }

            int newQty = qty + (existing == null ? 0 : existing.getQuantity());

            if (newQty > f.getStock()) {
                throw new InsufficientStockException(
                        "Only " + f.getStock() + " units of " + f.getName() + " are available."
                );
            }

            if (existing == null)
                cart.add(new OrderItem(f.getId(), f.getName(), f.getPrice(), qty));
            else
                existing.setQuantity(newQty);

            refreshCart();
            quantitySpinner.setValue(1);

        } catch (NumberFormatException | InvalidOrderException | InsufficientStockException e) {
            showError(e.getMessage());
        }
    }

    private void refreshCart() {
        cartModel.setRowCount(0);
        double total = 0;

        for (OrderItem item : cart) {
            double subtotal = item.getSubtotal();
            total += subtotal;

            cartModel.addRow(new Object[]{
                    item.getFoodId(),
                    item.getFoodName(),
                    String.format(Locale.US, "%.2f", item.getPrice()),
                    item.getQuantity(),
                    String.format(Locale.US, "%.2f", subtotal)
            });
        }

        totalLabel.setText(String.format(Locale.US, "Total: Rs.%.2f", total));
    }

    private void modifyCartQuantity() {
        int row = cartTable.getSelectedRow();

        if (row < 0) {
            showError("Select a cart item first.");
            return;
        }

        try {
            int newQty = Integer.parseInt(
                    JOptionPane.showInputDialog(this, "Enter new quantity:")
            );

            if (newQty <= 0) throw new NumberFormatException();

            OrderItem item = cart.get(row);
            FoodItem food = foodMap.get(item.getFoodId());

            if (food == null) {
                showError("Food item no longer exists.");
                return;
            }

            if (newQty > food.getStock()) {
                showError("Insufficient stock. Available: " + food.getStock());
                return;
            }

            item.setQuantity(newQty);
            refreshCart();

        } catch (Exception e) {
            showError("Enter a valid quantity.");
        }
    }

    private void removeFromCart() {
        int row = cartTable.getSelectedRow();

        if (row < 0) {
            showError("Select a cart item first.");
            return;
        }

        cart.remove(row);
        refreshCart();
    }

    private void cancelCart() {
        if (cart.isEmpty()) {
            showError("Cart is already empty.");
            return;
        }

        cart.clear();
        refreshCart();
        showSuccess("Current order cancelled.");
    }

    // ================= ORDER TRANSACTION + SYNCHRONIZATION =================
    private synchronized void placeOrder(int customerId, ArrayList<OrderItem> orderCart)
            throws Exception {

        if (orderCart == null || orderCart.isEmpty())
            throw new InvalidOrderException("Cart is empty.");

        try (Connection con = DBConnection.getConnection()) {
            con.setAutoCommit(false);

            try {
                // Verify customer
                String customerSQL =
                        "SELECT customer_id FROM customers WHERE customer_id=?";

                try (PreparedStatement ps = con.prepareStatement(customerSQL)) {
                    ps.setInt(1, customerId);
                    try (ResultSet rs = ps.executeQuery()) {
                        if (!rs.next())
                            throw new InvalidOrderException("Customer ID does not exist.");
                    }
                }

                // Lock and verify stock
                String stockSQL =
                        "SELECT food_name,price,stock FROM food_items WHERE food_id=? FOR UPDATE";

                double total = 0;

                for (OrderItem item : orderCart) {
                    try (PreparedStatement ps = con.prepareStatement(stockSQL)) {
                        ps.setInt(1, item.getFoodId());

                        try (ResultSet rs = ps.executeQuery()) {
                            if (!rs.next())
                                throw new InvalidOrderException(
                                        "Food ID " + item.getFoodId() + " does not exist."
                                );

                            int stock = rs.getInt("stock");
                            double price = rs.getDouble("price");
                            String name = rs.getString("food_name");

                            if (item.getQuantity() <= 0)
                                throw new InvalidOrderException("Invalid quantity for " + name);

                            if (item.getQuantity() > stock)
                                throw new InsufficientStockException(
                                        "Insufficient stock for " + name +
                                        ". Available: " + stock
                                );

                            item.setQuantity(item.getQuantity());
                            total += price * item.getQuantity();
                        }
                    }
                }

                // Insert order
                int orderId;

                String orderSQL =
                        "INSERT INTO orders(customer_id,total_amount,status,order_date) " +
                        "VALUES(?,?,?,CURRENT_TIMESTAMP)";

                try (PreparedStatement ps = con.prepareStatement(
                        orderSQL, Statement.RETURN_GENERATED_KEYS)) {

                    ps.setInt(1, customerId);
                    ps.setDouble(2, total);
                    ps.setString(3, "PLACED");
                    ps.executeUpdate();

                    try (ResultSet keys = ps.getGeneratedKeys()) {
                        if (!keys.next())
                            throw new SQLException("Could not create order ID.");

                        orderId = keys.getInt(1);
                    }
                }

                // Insert order items and update stock
                String itemSQL =
                        "INSERT INTO order_items(order_id,food_id,quantity,price) VALUES(?,?,?,?)";

                String updateStockSQL =
                        "UPDATE food_items SET stock=stock-? WHERE food_id=?";

                try (PreparedStatement itemPS = con.prepareStatement(itemSQL);
                     PreparedStatement stockPS = con.prepareStatement(updateStockSQL)) {

                    for (OrderItem item : orderCart) {
                        double currentPrice;

                        try (PreparedStatement pricePS = con.prepareStatement(
                                "SELECT price FROM food_items WHERE food_id=?")) {
                            pricePS.setInt(1, item.getFoodId());
                            try (ResultSet rs = pricePS.executeQuery()) {
                                if (!rs.next())
                                    throw new InvalidOrderException("Food item unavailable.");
                                currentPrice = rs.getDouble("price");
                            }
                        }

                        itemPS.setInt(1, orderId);
                        itemPS.setInt(2, item.getFoodId());
                        itemPS.setInt(3, item.getQuantity());
                        itemPS.setDouble(4, currentPrice);
                        itemPS.executeUpdate();

                        stockPS.setInt(1, item.getQuantity());
                        stockPS.setInt(2, item.getFoodId());
                        stockPS.executeUpdate();
                    }
                }

                // Insert bill
                String billSQL =
                        "INSERT INTO bills(order_id,total_amount) VALUES(?,?)";

                try (PreparedStatement ps = con.prepareStatement(billSQL)) {
                    ps.setInt(1, orderId);
                    ps.setDouble(2, total);
                    ps.executeUpdate();
                }

                con.commit();
                orderList.add(orderId);

            } catch (Exception e) {
                con.rollback();
                throw e;
            } finally {
                con.setAutoCommit(true);
            }
        }
    }

    private void submitOrder() {
        if (cart.isEmpty()) {
            showError("Cart is empty.");
            return;
        }

        try {
            int customerId = Integer.parseInt(orderCustomerIdField.getText().trim());

            String checkCustomer = "SELECT customer_id FROM customers WHERE customer_id=?";

            try (Connection con = DBConnection.getConnection();
                 PreparedStatement ps = con.prepareStatement(checkCustomer)) {

                ps.setInt(1, customerId);

                try (ResultSet rs = ps.executeQuery()) {
                    if (!rs.next()) {
                        showError("Customer ID does not exist.\nPlease register first.");
                        return;
                    }
                }

            } catch (SQLException e) {
                showError("Database Error:\n" + e.getMessage());
                return;
            }

            ArrayList<OrderItem> orderCart = new ArrayList<>();

            for (OrderItem item : cart) {
                orderCart.add(new OrderItem(
                        item.getFoodId(),
                        item.getFoodName(),
                        item.getPrice(),
                        item.getQuantity()
                ));
            }

            setStatus("Processing order in background...");

            executor.submit(() -> {
                try {
                    placeOrder(customerId, orderCart);

                    SwingUtilities.invokeLater(() -> {
                        showSuccess("Order placed successfully!\nBill generated automatically.");
                        cart.clear();
                        refreshCart();
                        loadFoodItems();
                        loadOrders();
                        updateDashboard();
                        setStatus("Order completed successfully");
                    });

                } catch (Exception ex) {
                    SwingUtilities.invokeLater(() -> {
                        showError("Order failed:\n" + ex.getMessage());
                        setStatus("Order failed");
                    });
                }
            });

        } catch (NumberFormatException e) {
            showError("Enter a valid Customer ID.");
        }
    }

