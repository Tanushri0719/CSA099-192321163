    // ================= OOP: INHERITANCE + POLYMORPHISM =================
    static abstract class User {
        private int id;
        private String name;
        private String phone;

        User(int id, String name, String phone) {
            this.id = id;
            this.name = name;
            this.phone = phone;
        }

        int getId() { return id; }
        String getName() { return name; }
        String getPhone() { return phone; }

        abstract String getUserType();
    }

    static class Student extends User {
        Student(int id, String name, String phone) { super(id, name, phone); }
        @Override String getUserType() { return "Student"; }
    }

    static class Faculty extends User {
        Faculty(int id, String name, String phone) { super(id, name, phone); }
        @Override String getUserType() { return "Faculty"; }
    }

    static class Staff extends User {
        Staff(int id, String name, String phone) { super(id, name, phone); }
        @Override String getUserType() { return "Staff"; }
    }

    static class FoodItem {
        private int id;
        private String name;
        private String category;
        private double price;
        private int stock;

        FoodItem(int id, String name, String category, double price, int stock) {
            this.id = id;
            this.name = name;
            this.category = category;
            this.price = price;
            this.stock = stock;
        }

        int getId() { return id; }
        String getName() { return name; }
        String getCategory() { return category; }
        double getPrice() { return price; }
        int getStock() { return stock; }

        void setStock(int stock) { this.stock = stock; }
    }

    static class OrderItem {
        private int foodId;
        private String foodName;
        private double price;
        private int quantity;

        OrderItem(int foodId, String foodName, double price, int quantity) {
            this.foodId = foodId;
            this.foodName = foodName;
            this.price = price;
            this.quantity = quantity;
        }

        int getFoodId() { return foodId; }
        String getFoodName() { return foodName; }
        double getPrice() { return price; }
        int getQuantity() { return quantity; }
        void setQuantity(int quantity) { this.quantity = quantity; }
        double getSubtotal() { return price * quantity; }
    }

