    private void registerCustomer() {
        String name = customerNameField.getText().trim();
        String phone = customerPhoneField.getText().trim();
        String email = customerEmailField.getText().trim();
        String type = (String) customerTypeCombo.getSelectedItem();

        if (name.isEmpty() || phone.isEmpty()) {
            showError("Name and phone are required.");
            return;
        }

        String sql = "INSERT INTO customers(name,phone,email,user_type) VALUES(?,?,?,?)";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, name);
            ps.setString(2, phone);
            ps.setString(3, email);
            ps.setString(4, type);

            ps.executeUpdate();
            showSuccess("Customer registered successfully.");
            clearCustomerForm();
            loadCustomers();
            updateDashboard();

        } catch (SQLException e) {
            showError("Customer registration failed:\n" + e.getMessage());
        }
    }

    private void clearCustomerForm() {
        customerNameField.setText("");
        customerPhoneField.setText("");
        customerEmailField.setText("");
        customerTypeCombo.setSelectedIndex(0);
    }

    private void loadCustomers() {
        if (customerModel == null) return;
        customerModel.setRowCount(0);
        customers.clear();

        String sql = "SELECT customer_id,name,phone,email,user_type FROM customers ORDER BY customer_id";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                int id = rs.getInt("customer_id");
                String name = rs.getString("name");
                String phone = rs.getString("phone");
                String email = rs.getString("email");
                String type = rs.getString("user_type");

                customerModel.addRow(new Object[]{id, name, phone, email, type});

                if ("Faculty".equalsIgnoreCase(type))
                    customers.add(new Faculty(id, name, phone));
                else if ("Staff".equalsIgnoreCase(type))
                    customers.add(new Staff(id, name, phone));
                else
                    customers.add(new Student(id, name, phone));
            }

        } catch (SQLException e) {
            showError("Could not load customers:\n" + e.getMessage());
        }
    }

