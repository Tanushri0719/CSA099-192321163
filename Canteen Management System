    private void loadOrders() {
        if (ordersModel == null) return;

        ordersModel.setRowCount(0);
        orderList.clear();

        String sql =
                "SELECT order_id,customer_id,total_amount,status,order_date " +
                "FROM orders ORDER BY order_id DESC";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                int orderId = rs.getInt("order_id");
                orderList.add(orderId);

                Timestamp date = rs.getTimestamp("order_date");

                ordersModel.addRow(new Object[]{
                        orderId,
                        rs.getInt("customer_id"),
                        String.format(Locale.US, "%.2f", rs.getDouble("total_amount")),
                        rs.getString("status"),
                        date == null ? "" :
                                new SimpleDateFormat("dd-MM-yyyy HH:mm").format(new java.util.Date(date.getTime()))
                });
            }

        } catch (SQLException e) {
            showError("Could not load orders:\n" + e.getMessage());
        }
    }

    private void updateOrderStatus() {
        int row = ordersTable.getSelectedRow();

        if (row < 0) {
            showError("Select an order first.");
            return;
        }

        int orderId = Integer.parseInt(ordersModel.getValueAt(row, 0).toString());
        String status = (String) orderStatusCombo.getSelectedItem();

        String sql = "UPDATE orders SET status=? WHERE order_id=?";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, status);
            ps.setInt(2, orderId);

            if (ps.executeUpdate() == 0) {
                showError("Order not found.");
                return;
            }

            showSuccess("Order status updated to " + status + ".");
            loadOrders();

        } catch (SQLException e) {
            showError("Status update failed:\n" + e.getMessage());
        }
    }

    private void viewBill() {
        int row = ordersTable.getSelectedRow();

        if (row < 0) {
            showError("Select an order first.");
            return;
        }

        int orderId = Integer.parseInt(ordersModel.getValueAt(row, 0).toString());

        String customer = "";
        String status = "";
        double total = 0;
        String date = "";

        try (Connection con = DBConnection.getConnection()) {

            String orderSQL =
                    "SELECT o.customer_id,o.total_amount,o.status,o.order_date,c.name,c.phone " +
                    "FROM orders o JOIN customers c ON o.customer_id=c.customer_id " +
                    "WHERE o.order_id=?";

            try (PreparedStatement ps = con.prepareStatement(orderSQL)) {
                ps.setInt(1, orderId);

                try (ResultSet rs = ps.executeQuery()) {
                    if (!rs.next()) {
                        showError("Order not found.");
                        return;
                    }

                    customer = rs.getString("name") + " (" + rs.getString("phone") + ")";
                    status = rs.getString("status");
                    total = rs.getDouble("total_amount");

                    Timestamp ts = rs.getTimestamp("order_date");
                    if (ts != null) {
                        date = new SimpleDateFormat("dd-MM-yyyy HH:mm")
                                .format(new java.util.Date(ts.getTime()));
                    }
                }
            }

            StringBuilder bill = new StringBuilder();
            bill.append("========================================\n");
            bill.append("          CANTEEN BILL RECEIPT          \n");
            bill.append("========================================\n");
            bill.append("Order ID : ").append(orderId).append("\n");
            bill.append("Customer : ").append(customer).append("\n");
            bill.append("Date     : ").append(date).append("\n");
            bill.append("Status   : ").append(status).append("\n");
            bill.append("----------------------------------------\n");

            String itemSQL =
                    "SELECT f.food_name,oi.quantity,oi.price " +
                    "FROM order_items oi JOIN food_items f ON oi.food_id=f.food_id " +
                    "WHERE oi.order_id=?";

            try (PreparedStatement ps = con.prepareStatement(itemSQL)) {
                ps.setInt(1, orderId);

                try (ResultSet rs = ps.executeQuery()) {
                    while (rs.next()) {
                        String name = rs.getString("food_name");
                        int qty = rs.getInt("quantity");
                        double price = rs.getDouble("price");
                        double subtotal = qty * price;

                        bill.append(String.format(Locale.US,
                                "%-20s %3d x %7.2f = %8.2f%n",
                                name, qty, price, subtotal));
                    }
                }
            }

            bill.append("----------------------------------------\n");
            bill.append(String.format(Locale.US, "TOTAL: Rs.%.2f%n", total));
            bill.append("========================================\n");
            bill.append("          Thank you! Visit again.       \n");

            JTextArea area = new JTextArea(bill.toString());
            area.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 13));
            area.setEditable(false);
            area.setBackground(Color.WHITE);
            area.setBorder(new EmptyBorder(15, 15, 15, 15));

            JOptionPane.showMessageDialog(
                    this, new JScrollPane(area),
                    "Bill - Order #" + orderId,
                    JOptionPane.INFORMATION_MESSAGE
            );

        } catch (SQLException e) {
            showError("Could not display bill:\n" + e.getMessage());
        }
    }

    // ================= DASHBOARD STATS =================
    private void updateDashboard() {
        if (customerCountLabel == null) return;

        try (Connection con = DBConnection.getConnection()) {

            try (PreparedStatement ps = con.prepareStatement(
                    "SELECT COUNT(*) FROM customers");
                 ResultSet rs = ps.executeQuery()) {
                if (rs.next()) customerCountLabel.setText(rs.getString(1));
            }

            try (PreparedStatement ps = con.prepareStatement(
                    "SELECT COUNT(*) FROM food_items");
                 ResultSet rs = ps.executeQuery()) {
                if (rs.next()) foodCountLabel.setText(rs.getString(1));
            }

            try (PreparedStatement ps = con.prepareStatement(
                    "SELECT COUNT(*) FROM orders");
                 ResultSet rs = ps.executeQuery()) {
                if (rs.next()) orderCountLabel.setText(rs.getString(1));
            }

            try (PreparedStatement ps = con.prepareStatement(
                    "SELECT COALESCE(SUM(total_amount),0) FROM bills");
                 ResultSet rs = ps.executeQuery()) {
                if (rs.next())
                    revenueLabel.setText(String.format(Locale.US, "Rs.%.2f", rs.getDouble(1)));
            }

        } catch (SQLException e) {
            setStatus("Database connection error");
        }
    }

    // ================= TABLE STYLE =================
    private void styleTable(JTable table) {
        table.setRowHeight(32);
        table.setFont(new Font("SansSerif", Font.PLAIN, 12));
        table.setForeground(TEXT);
        table.setBackground(Color.WHITE);
        table.setGridColor(new Color(235, 238, 243));
        table.setSelectionBackground(new Color(220, 232, 247));
        table.setSelectionForeground(TEXT);
        table.setShowVerticalLines(false);
        table.setIntercellSpacing(new Dimension(0, 1));

        JTableHeader header = table.getTableHeader();
        header.setPreferredSize(new Dimension(0, 38));
        header.setFont(new Font("SansSerif", Font.BOLD, 12));
        header.setForeground(Color.WHITE);
        header.setBackground(NAVY);
        header.setOpaque(true);

        DefaultTableCellRenderer center = new DefaultTableCellRenderer();
        center.setHorizontalAlignment(SwingConstants.CENTER);

        for (int i = 0; i < table.getColumnCount(); i++) {
            if (i == 0 || i == 3 || i == 4)
                table.getColumnModel().getColumn(i).setCellRenderer(center);
        }
    }

    // ================= NAVIGATION =================
    private void showPage(String page) {
        pageTitle.setText(page);

        CardLayout cl = (CardLayout) contentPanel.getLayout();
        cl.show(contentPanel, page);

        if ("Dashboard".equals(page)) updateDashboard();
        if ("Customers".equals(page)) loadCustomers();
        if ("Food Menu".equals(page)) loadFoodItems();
        if ("Orders / Admin".equals(page)) loadOrders();
        if ("Place Order".equals(page)) {
            loadFoodItems();
            refreshCart();
        }

        setStatus("Ready");
    }

