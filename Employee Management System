    // ================= VALIDATION =================
    private boolean validateFields() {
        if (txtId.getText().trim().isEmpty()) {
            showError("Employee ID cannot be blank.");
            txtId.requestFocus();
            return false;
        }
        if (txtName.getText().trim().isEmpty()) {
            showError("Employee name cannot be blank.");
            txtName.requestFocus();
            return false;
        }
        if (txtDate.getText().trim().isEmpty()) {
            showError("Date of joining cannot be blank.");
            txtDate.requestFocus();
            return false;
        }
        if (txtSalary.getText().trim().isEmpty()) {
            showError("Salary cannot be blank.");
            txtSalary.requestFocus();
            return false;
        }
        if (txtEmail.getText().trim().isEmpty()) {
            showError("Email cannot be blank.");
            txtEmail.requestFocus();
            return false;
        }
        if (txtPhone.getText().trim().isEmpty()) {
            showError("Phone number cannot be blank.");
            txtPhone.requestFocus();
            return false;
        }

        try {
            Integer.parseInt(txtId.getText().trim());
        } catch (NumberFormatException e) {
            showError("Employee ID must be numeric.");
            return false;
        }

        try {
            Double.parseDouble(txtSalary.getText().trim());
        } catch (NumberFormatException e) {
            showError("Salary must be numeric.");
            return false;
        }

        try {
            Date.valueOf(txtDate.getText().trim());
        } catch (IllegalArgumentException e) {
            showError("Date must be in YYYY-MM-DD format.");
            return false;
        }

        String email = txtEmail.getText().trim();
        if (!email.matches("^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+$")) {
            showError("Enter a valid email address.");
            return false;
        }

        if (!txtPhone.getText().trim().matches("\\d{10}")) {
            showError("Phone number must contain exactly 10 digits.");
            return false;
        }

        return true;
    }

    // ================= ADD =================
    private void addEmployee() {
        if (!validateFields()) return;

        String sql = "INSERT INTO employee " +
                "(emp_id, emp_name, department, designation, date_of_joining, salary, email, phone, status) " +
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)";

        try (Connection con = getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setInt(1, Integer.parseInt(txtId.getText().trim()));
            ps.setString(2, txtName.getText().trim());
            ps.setString(3, cmbDepartment.getSelectedItem().toString());
            ps.setString(4, cmbDesignation.getSelectedItem().toString());
            ps.setDate(5, Date.valueOf(txtDate.getText().trim()));
            ps.setDouble(6, Double.parseDouble(txtSalary.getText().trim()));
            ps.setString(7, txtEmail.getText().trim());
            ps.setString(8, txtPhone.getText().trim());
            ps.setString(9, rbActive.isSelected() ? "Active" : "Inactive");

            ps.executeUpdate();

            JOptionPane.showMessageDialog(this, "Employee added successfully!", "Success",
                    JOptionPane.INFORMATION_MESSAGE);
            lblStatus.setText("Record added successfully.");
            clearFields();
            loadEmployees();

        } catch (SQLIntegrityConstraintViolationException e) {
            showError("Employee ID already exists.");
        } catch (SQLException e) {
            showError("Database error: " + e.getMessage());
        }
    }

    // ================= UPDATE =================
    private void updateEmployee() {
        if (table.getSelectedRow() == -1) {
            showError("Please select an employee.");
            return;
        }
        if (!validateFields()) return;

        String sql = "UPDATE employee SET emp_name=?, department=?, designation=?, " +
                "date_of_joining=?, salary=?, email=?, phone=?, status=? WHERE emp_id=?";

        Connection con = null;
        try {
            con = getConnection();
            con.setAutoCommit(false);

            try (PreparedStatement ps = con.prepareStatement(sql)) {
                ps.setString(1, txtName.getText().trim());
                ps.setString(2, cmbDepartment.getSelectedItem().toString());
                ps.setString(3, cmbDesignation.getSelectedItem().toString());
                ps.setDate(4, Date.valueOf(txtDate.getText().trim()));
                ps.setDouble(5, Double.parseDouble(txtSalary.getText().trim()));
                ps.setString(6, txtEmail.getText().trim());
                ps.setString(7, txtPhone.getText().trim());
                ps.setString(8, rbActive.isSelected() ? "Active" : "Inactive");
                ps.setInt(9, Integer.parseInt(txtId.getText().trim()));
                ps.executeUpdate();
            }

            con.commit();
            JOptionPane.showMessageDialog(this, "Employee updated successfully!", "Success",
                    JOptionPane.INFORMATION_MESSAGE);
            lblStatus.setText("Record updated successfully.");
            clearFields();
            loadEmployees();

        } catch (SQLException e) {
            if (con != null) {
                try { con.rollback(); } catch (SQLException ignored) { }
            }
            showError("Update failed: " + e.getMessage());
        } finally {
            if (con != null) {
                try { con.close(); } catch (SQLException ignored) { }
            }
        }
    }

    // ================= DELETE =================
    private void deleteEmployee() {
        if (table.getSelectedRow() == -1) {
            showError("Please select an employee.");
            return;
        }

        int choice = JOptionPane.showConfirmDialog(this,
                "Are you sure you want to delete this employee?",
                "Confirm Delete", JOptionPane.YES_NO_OPTION, JOptionPane.WARNING_MESSAGE);

        if (choice != JOptionPane.YES_OPTION) return;

        String sql = "DELETE FROM employee WHERE emp_id=?";
        Connection con = null;

        try {
            con = getConnection();
            con.setAutoCommit(false);

            try (PreparedStatement ps = con.prepareStatement(sql)) {
                ps.setInt(1, Integer.parseInt(txtId.getText().trim()));
                ps.executeUpdate();
            }

            con.commit();
            JOptionPane.showMessageDialog(this, "Employee deleted successfully!", "Success",
                    JOptionPane.INFORMATION_MESSAGE);
            lblStatus.setText("Record deleted successfully.");
            clearFields();
            loadEmployees();

        } catch (SQLException e) {
            if (con != null) {
                try { con.rollback(); } catch (SQLException ignored) { }
            }
            showError("Delete failed: " + e.getMessage());
        } finally {
            if (con != null) {
                try { con.close(); } catch (SQLException ignored) { }
            }
        }
    }

    // ================= LOAD =================
    private void loadEmployees() {
        String sql = "SELECT * FROM employee ORDER BY emp_id";
        model.setRowCount(0);

        try (Connection con = getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            int count = 0;
            while (rs.next()) {
                addTableRow(rs);
                count++;
            }

            lblCount.setText(count + (count == 1 ? " record" : " records"));
            lblStatus.setText("Records loaded successfully.");
            lblConnection.setText("Database: Connected");
            lblConnection.setForeground(new Color(164, 232, 194));

        } catch (SQLException e) {
            lblConnection.setText("Database: Not connected");
            lblConnection.setForeground(new Color(255, 180, 180));
            showError("Unable to load records: " + e.getMessage());
        }
    }

    private void addTableRow(ResultSet rs) throws SQLException {
        model.addRow(new Object[]{
                rs.getInt("emp_id"),
                rs.getString("emp_name"),
                rs.getString("department"),
                rs.getString("designation"),
                rs.getDate("date_of_joining"),
                rs.getDouble("salary"),
                rs.getString("email"),
                rs.getString("phone"),
                rs.getString("status")
        });
    }

    // ================= SEARCH =================
    private void searchEmployees() {
        String searchText = txtSearch.getText().trim();
        if (searchText.isEmpty()) {
            loadEmployees();
            return;
        }

        String selected = cmbSearch.getSelectedItem().toString();
        String column = selected.equals("ID") ? "emp_id" :
                selected.equals("Name") ? "emp_name" : "department";

        String sql;
        if (column.equals("emp_id")) {
            sql = "SELECT * FROM employee WHERE CAST(emp_id AS CHAR) LIKE ? ORDER BY emp_id";
        } else {
            sql = "SELECT * FROM employee WHERE " + column + " LIKE ? ORDER BY emp_id";
        }

        model.setRowCount(0);

        try (Connection con = getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, "%" + searchText + "%");

            try (ResultSet rs = ps.executeQuery()) {
                int count = 0;
                while (rs.next()) {
                    addTableRow(rs);
                    count++;
                }
                lblCount.setText(count + (count == 1 ? " record" : " records"));
                lblStatus.setText("Search completed.");
            }

        } catch (SQLException e) {
            showError("Search failed: " + e.getMessage());
        }
    }

    // ================= TABLE TO FORM =================
    private void fillFieldsFromTable() {
        int selectedRow = table.getSelectedRow();
        if (selectedRow == -1) return;

        int row = table.convertRowIndexToModel(selectedRow);

        txtId.setText(model.getValueAt(row, 0).toString());
        txtName.setText(model.getValueAt(row, 1).toString());
        cmbDepartment.setSelectedItem(model.getValueAt(row, 2).toString());
        cmbDesignation.setSelectedItem(model.getValueAt(row, 3).toString());
        txtDate.setText(model.getValueAt(row, 4).toString());
        txtSalary.setText(model.getValueAt(row, 5).toString());
        txtEmail.setText(model.getValueAt(row, 6).toString());
        txtPhone.setText(model.getValueAt(row, 7).toString());

        String status = model.getValueAt(row, 8).toString();
        rbActive.setSelected(status.equalsIgnoreCase("Active"));
        rbInactive.setSelected(!status.equalsIgnoreCase("Active"));

        txtId.setEnabled(false);
        btnUpdate.setEnabled(true);
        btnDelete.setEnabled(true);
        lblStatus.setText("Employee selected. You can update or delete this record.");
    }

    // ================= CLEAR =================
    private void clearFields() {
        txtId.setText("");
        txtName.setText("");
        txtDate.setText("");
        txtSalary.setText("");
        txtEmail.setText("");
        txtPhone.setText("");
        cmbDepartment.setSelectedIndex(0);
        cmbDesignation.setSelectedIndex(0);
        rbActive.setSelected(true);

        txtId.setEnabled(true);
        table.clearSelection();
        btnUpdate.setEnabled(false);
        btnDelete.setEnabled(false);
        lblStatus.setText("Ready");
    }

